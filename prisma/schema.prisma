generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  email       String     @unique
  name        String
  avatarUrl   String?
  status      String     @default("ACTIVE") // ACTIVE, SUSPENDED, INACTIVE
  lastLoginAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  roles       UserRole[]
  auditLogs   AuditLog[]

  @@map("users")
}

model Role {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  name        String     @unique // 'admin', 'directivo', 'coordinador', 'tutor', 'docente', etc.
  displayName String
  description String?
  isSystem    Boolean    @default(true)
  createdAt   DateTime   @default(now())

  users       UserRole[]

  @@map("roles")
}

model UserRole {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  roleId     String   @db.ObjectId
  assignedAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
  role       Role     @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Application {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  code          String   @unique // 'tutorias', 'proyectos-integradores', etc.
  name          String
  description   String
  url           String
  icon          String   // Lucide icon name (fallback si no hay logoUrl)
  logoUrl       String?  // Logo personalizado (base64 data URL)
  category      String   // 'Académica', 'Gestión', 'Servicios', 'Administración'
  authType      String   @default("GOOGLE_SESSION") // 'GOOGLE_SESSION', 'SSO_JWT_TOKEN', etc.
  openIn        String   @default("_blank") // '_blank', '_self'
  orderIndex    Int      @default(0)
  status        String   @default("ACTIVE") // 'ACTIVE', 'MAINTENANCE', 'INACTIVE'
  isVisible     Boolean  @default(true)
  requiredRoles String   @default("") // Comma-separated role names
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("applications")
}

model AuditLog {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String?  @db.ObjectId
  userEmail      String?
  action         String   // 'AUTH_LOGIN', 'APP_LAUNCH', 'APP_CREATE', etc.
  targetResource String?
  details        String?  // JSON stringified details
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  user           User?    @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
