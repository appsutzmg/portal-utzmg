# Local (docker compose up -d): mongodb://localhost:27017/portal_utzmg
# MongoDB Atlas: mongodb+srv://usuario:password@cluster.mongodb.net/portal_utzmg?retryWrites=true&w=majority
DATABASE_URL="mongodb://localhost:27017/portal_utzmg"
JWT_SECRET="genera-una-clave-secreta-larga-y-segura"
NEXT_PUBLIC_APP_URL="https://portal.utzmg.edu.mx"
INSTITUTIONAL_DOMAIN="utzmg.edu.mx"
NEXT_PUBLIC_ADMIN_EMAIL="apps@utzmg.edu.mx"

# Envío de correo (solicitudes de acceso) — obligatorio en producción
# Google Workspace: smtp.gmail.com, puerto 587, contraseña de aplicación
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="apps@utzmg.edu.mx"
SMTP_PASS="contraseña-de-aplicacion"
SMTP_FROM="Portal UTZMG <apps@utzmg.edu.mx>"

# Credenciales de Google OAuth 2.0 (Google Workspace)
GOOGLE_CLIENT_ID="tu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-google-client-secret"

# Habilitar perfiles de demostración en desarrollo
ENABLE_DEMO_ACCOUNTS="true"

# Acceso por usuario sin Google — solo desarrollo local (no configurar en Render)
ALLOW_EMAIL_ONLY_LOGIN="true"
NEXT_PUBLIC_ALLOW_EMAIL_ONLY_LOGIN="true"
